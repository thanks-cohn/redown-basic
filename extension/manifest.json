{
  "manifest_version": 3,
  "name": "REDOWN Basic",
  "version": "0.1.0",
  "description": "Save downloadable resources to Google Drive, Dropbox, or OneDrive with verified outcomes.",
  "permissions": ["contextMenus", "storage", "identity", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Open REDOWN Basic" },
  "options_page": "shelf.html",
  "oauth2": {
    "client_id": "CONFIGURE_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
